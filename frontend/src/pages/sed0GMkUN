
import { useDropzone } from 'react-dropzone'
import { motion, AnimatePresence } from 'framer-motion'
import { Upload, File, Shield, Key, CheckCircle, Copy, AlertCircle, Loader2 } from 'lucide-react'
import { stegoApi } from '@/services/api'
import { useStore } from '@/store/useStore'

export function Embed() {
  const [cover, setCover] = useState<File | null>(null)
  const [secret, setSecret] = useState<File | null>(null)
  const [method, setMethod] = useState<'LSB' | 'Adaptive'>('LSB')
  const [password, setPassword] = useState('')
  const [isProcessing, setIsProcessing] = useState(false)
  const [result, setResult] = useState<{ image: string, token?: string } | null>(null)
  const setStatus = useStore(state => state.setStatus)

  const onDropCover = useCallback((acceptedFiles: File[]) => {
    setCover(acceptedFiles[0])
  }, [])

  const onDropSecret = useCallback((acceptedFiles: File[]) => {
    setSecret(acceptedFiles[0])
  }, [])

  const { getRootProps: getCoverProps, getInputProps: getCoverInputProps, isDragActive: isCoverActive } = useDropzone({ 
    onDrop: onDropCover,
    accept: { 'image/*': [] },
    multiple: false
  })

  const { getRootProps: getSecretProps, getInputProps: getSecretInputProps, isDragActive: isSecretActive } = useDropzone({ 
    onDrop: onDropSecret,
    multiple: false
  })

  const handleEmbed = async () => {
    if (!cover || !secret) return
    
    setIsProcessing(true)
    setStatus('UPLOADING')
    
    const formData = new FormData()
    formData.append('cover', cover)
    formData.append('secret', secret)
    formData.append('method', method)
    formData.append('password', password)

    try {
      const res = await stegoApi.embed(formData)
      setResult({
        image: `data:image/png;base64,${res.data.image_data}`,
        token: res.data.recovery_token
      })
      setStatus('SECURE')
    } catch (err) {
      console.error(err)
      setStatus('IDLE')
    } finally {
      setIsProcessing(false)
    }
  }

  return (
    <div className="max-w-6xl mx-auto space-y-8">
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {/* Input Panel */}
        <div className="space-y-6">
          <div className="glass-panel rounded-3xl p-8 space-y-6">
            <h3 className="text-xl font-bold flex items-center gap-2">
              <Upload className="h-5 w-5 text-primary" />
              Source Configuration
            </h3>

            {/* Cover Image Uploader */}
            <div 
              {...getCoverProps()} 
              className={`relative h-48 border-2 border-dashed rounded-2xl flex flex-col items-center justify-center transition-all cursor-pointer ${
                isCoverActive ? 'border-primary bg-primary/5' : 'border-white/10 hover:border-white/20'
              }`}
            >
              <input {...getCoverInputProps()} />
              {cover ? (
                <div className="text-center">
                  <CheckCircle className="h-8 w-8 text-primary mx-auto mb-2" />
                  <p className="text-sm font-medium">{cover.name}</p>
                </div>
              ) : (
                <div className="text-center opacity-40">
                  <Upload className="h-8 w-8 mx-auto mb-2" />
                  <p className="text-sm font-medium italic">Drop Cover Image</p>
                </div>
              )}
            </div>

            {/* Secret File Uploader */}
            <div 
              {...getSecretProps()} 
              className={`relative h-32 border-2 border-dashed rounded-2xl flex flex-col items-center justify-center transition-all cursor-pointer ${
                isSecretActive ? 'border-accent bg-accent/5' : 'border-white/10 hover:border-white/20'
              }`}
            >
              <input {...getSecretInputProps()} />
              {secret ? (
                <div className="text-center">
                  <File className="h-6 w-6 text-accent mx-auto mb-2" />
                  <p className="text-sm font-medium">{secret.name}</p>
                </div>
              ) : (
                <div className="text-center opacity-40">
                  <File className="h-6 w-6 mx-auto mb-2" />
                  <p className="text-sm font-medium italic">Drop Payload File</p>
                </div>
              )}
            </div>

            {/* Options */}
            <div className="space-y-4">
              <div className="grid grid-cols-2 gap-4">
                <button 
                  onClick={() => setMethod('LSB')}
                  className={`py-3 rounded-xl text-xs font-bold tracking-widest transition-all ${
                    method === 'LSB' ? 'bg-white/10 border border-white/20' : 'bg-transparent border border-white/5 opacity-40 hover:opacity-100'
                  }`}
                >
                  STANDARD LSB
                </button>
                <button 
                  onClick={() => setMethod('Adaptive')}
                  className={`py-3 rounded-xl text-xs font-bold tracking-widest transition-all ${
                    method === 'Adaptive' ? 'bg-primary/20 border border-primary/40 text-primary' : 'bg-transparent border border-white/5 opacity-40 hover:opacity-100'
                  }`}
                >
                  ADAPTIVE EDGE
                </button>
              </div>

              <div className="relative">
                <Key className="absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 text-white/20" />
                <input 
                  type="password"
                  placeholder="Encryption Key (Optional)"
                  className="w-full bg-white/5 border border-white/10 rounded-xl py-4 pl-12 pr-4 text-sm focus:outline-none focus:border-primary/50 transition-all"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                />
              </div>
            </div>

            <button 
              disabled={!cover || !secret || isProcessing}
              onClick={handleEmbed}
              className="w-full bg-primary hover:bg-primary/80 disabled:opacity-30 disabled:hover:bg-primary rounded-xl py-4 text-black font-black tracking-widest flex items-center justify-center gap-2 transition-all shadow-[0_0_20px_rgba(0,255,255,0.2)]"
            >
              {isProcessing ? <Loader2 className="h-5 w-5 animate-spin" /> : 'GENERATE STEGO-CONTAINER'}
            </button>
          </div>
        </div>

        {/* Results Panel */}
        <div className="space-y-6">
          <AnimatePresence mode="wait">
            {!result ? (
              <motion.div 
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                exit={{ opacity: 0 }}
                className="glass-panel rounded-3xl p-8 h-full flex flex-col items-center justify-center text-center opacity-40 border-dashed"
              >
                <Shield className="h-16 w-16 mb-4" />
                <h3 className="text-xl font-bold mb-2 tracking-tight italic">Waiting for Configuration...</h3>
                <p className="text-sm max-w-xs">Initialize embedding to view generated intelligence assets.</p>
              </motion.div>
            ) : (
              <motion.div 
                initial={{ opacity: 0, x: 20 }}
                animate={{ opacity: 1, x: 0 }}
                className="space-y-6"
              >
                <div className="glass-panel rounded-3xl p-4">
                  <img src={result.image} alt="Stego" className="w-full h-auto rounded-2xl shadow-2xl" />
                </div>

                {result.token && (
                  <div className="glass-panel rounded-3xl p-6 bg-primary/5 border-primary/20">
                    <div className="flex items-center justify-between mb-4">
                      <div className="flex items-center gap-2">
                        <Key className="h-4 w-4 text-primary" />
                        <span className="text-xs font-bold tracking-widest text-primary uppercase">Recovery Token Generated</span>
                      </div>
                      <button className="text-white/40 hover:text-white">
                        <Copy className="h-4 w-4" />
                      </button>
                    </div>
                    <div className="bg-black/40 rounded-xl p-4 font-mono text-sm break-all border border-white/5">
                      {result.token}
                    </div>
                    <p className="mt-4 text-[10px] text-white/40 flex items-start gap-2">
                      <AlertCircle className="h-3 w-3 mt-0.5 shrink-0" />
                      Store this token securely. It is the only way to recover data if the password is lost.
                    </p>
                  </div>
                )}

                <a 
                  href={result.image} 
                  download="stego_container.png"
                  className="w-full flex items-center justify-center gap-2 py-4 rounded-2xl border border-white/10 hover:border-white/20 bg-white/5 transition-all font-bold"
                >
                  <Upload className="h-4 w-4 rotate-180" />
                  DOWNLOAD ASSET
                </a>
              </motion.div>
            )}
          </AnimatePresence>
        </div>
      </div>
    </div>
  )
}
