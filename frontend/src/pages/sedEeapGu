
import { useDropzone } from 'react-dropzone'
import { motion, AnimatePresence } from 'framer-motion'
import { Canvas } from '@react-three/fiber'
import { Scanner3D } from '@/three/Scanner3D'
import { 
  ShieldAlert, 
  ShieldCheck, 
  Search, 
  Activity, 
  Cpu, 
  AlertCircle,
  Loader2,
  BarChart
} from 'lucide-react'
import { stegoApi } from '@/services/api'
import { useStore } from '@/store/useStore'

export function Analyze() {
  const [image, setImage] = useState<File | null>(null)
  const [preview, setPreview] = useState<string | null>(null)
  const [isScanning, setIsScanning] = useState(false)
  const [result, setResult] = useState<any | null>(null)
  const setStatus = useStore(state => state.setStatus)

  const onDrop = useCallback((acceptedFiles: File[]) => {
    const file = acceptedFiles[0]
    setImage(file)
    setPreview(URL.createObjectURL(file))
    setResult(null)
  }, [])

  const { getRootProps, getInputProps, isDragActive } = useDropzone({ 
    onDrop,
    accept: { 'image/*': [] },
    multiple: false
  })

  const handleScan = async () => {
    if (!image) return
    
    setIsScanning(true)
    setStatus('ANALYZING')
    
    const formData = new FormData()
    formData.append('image', image)

    try {
      const res = await stegoApi.analyze(formData)
      setResult(res.data)
      setStatus(res.data.detected ? 'COMPROMISED' : 'SECURE')
    } catch (err) {
      console.error(err)
      setStatus('IDLE')
    } finally {
      setIsScanning(false)
    }
  }

  const getVerdictStyle = (v: string) => {
    if (v === 'DETECTED') return 'text-red-500 border-red-500/20 bg-red-500/10 shadow-[0_0_15px_rgba(239,68,68,0.2)]'
    if (v === 'SUSPICIOUS') return 'text-amber-500 border-amber-500/20 bg-amber-500/10 shadow-[0_0_15px_rgba(245,158,11,0.2)]'
    return 'text-green-500 border-green-500/20 bg-green-500/10 shadow-[0_0_15px_rgba(34,197,94,0.2)]'
  }

  return (
    <div className="max-w-7xl mx-auto grid grid-cols-1 xl:grid-cols-3 gap-8">
      {/* 3D Viewport / Scanner */}
      <div className="xl:col-span-2 space-y-6">
        <div className="glass-panel rounded-3xl overflow-hidden aspect-video relative">
          <Suspense fallback={<div className="flex h-full items-center justify-center"><Loader2 className="animate-spin text-primary" /></div>}>
            <Canvas camera={{ position: [0, 0, 15] }}>
              <ambientLight intensity={0.5} />
              <pointLight position={[10, 10, 10]} intensity={1} />
              <Scanner3D image={preview || undefined} scanning={isScanning} />
            </Canvas>
          </Suspense>

          {/* Uploader Overlay */}
          {!preview && (
            <div 
              {...getRootProps()} 
              className="absolute inset-x-8 inset-y-8 border-2 border-dashed border-white/10 rounded-2xl flex flex-col items-center justify-center cursor-pointer hover:bg-white/5 transition-all"
            >
              <input {...getInputProps()} />
              <Search className="h-12 w-12 text-white/20 mb-4" />
              <p className="text-xl font-bold italic tracking-tighter text-white/40">DROP IMAGE FOR DEEP SCAN</p>
            </div>
          )}

          {/* Scan Controls */}
          {preview && !result && !isScanning && (
            <div className="absolute bottom-8 left-1/2 -translate-x-1/2">
                <button 
                  onClick={handleScan}
                  className="bg-primary hover:bg-primary/80 text-black px-12 py-4 rounded-xl font-black tracking-widest transition-all"
                >
                  INITIALIZE SCAN
                </button>
            </div>
          )}
        </div>

        {/* Confidence Gauge Strip */}
        <AnimatePresence>
          {result && (
            <motion.div 
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              className="glass-panel rounded-3xl p-8"
            >
              <div className="flex items-center justify-between mb-8">
                <div>
                  <h3 className="text-2xl font-black italic tracking-tighter">FORENSIC VERDICT</h3>
                  <p className="text-white/40 text-sm">Automated Steganalysis Report #A-{Math.floor(Math.random()*9000)+1000}</p>
                </div>
                <div className={`px-6 py-2 rounded-full border-2 font-black tracking-[0.2em] italic ${getVerdictStyle(result.verdict)}`}>
                  {result.verdict}
                </div>
              </div>

              <div className="space-y-6">
                <div>
                   <div className="flex items-center justify-between mb-2">
                        <span className="text-xs font-bold tracking-[0.1em] text-white/60">Neural Network Confidence</span>
                        <span className="text-xs font-mono font-bold">{(result.ai_analysis.score * 100).toFixed(2)}%</span>
                   </div>
                   <div className="h-2 w-full bg-white/5 rounded-full overflow-hidden">
                        <motion.div 
                            initial={{ width: 0 }}
                            animate={{ width: `${result.ai_analysis.score * 100}%` }}
                            transition={{ duration: 1.5, ease: "easeOut" }}
                            className={`h-full ${result.ai_analysis.score > 0.5 ? 'bg-red-500' : 'bg-primary'}`}
                        />
                   </div>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div className="p-4 rounded-2xl bg-white/5 border border-white/5">
                        <p className="text-[10px] font-bold tracking-widest text-white/30 uppercase mb-2">Heuristic Probe</p>
                        <p className="text-sm font-medium">{result.description}</p>
                    </div>
                    <div className="p-4 rounded-2xl bg-white/5 border border-white/5">
                        <p className="text-[10px] font-bold tracking-widest text-white/30 uppercase mb-2">Static Analysis</p>
                        <p className="text-sm font-medium">{result.static_analysis.message}</p>
                    </div>
                </div>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>

      {/* Sidebar Analysis Details */}
      <div className="space-y-6">
        <div className="glass-panel rounded-3xl p-6">
          <h4 className="text-xs font-black tracking-[0.2em] text-white/60 uppercase mb-6 flex items-center gap-2">
            <Activity className="h-4 w-4 text-primary" />
            System Status
          </h4>
          <div className="space-y-4">
            <div className="flex justify-between items-center text-sm py-2 border-b border-white/5">
              <span className="text-white/40">AI Engine</span>
              <span className="text-primary font-mono text-xs">ONLINE</span>
            </div>
            <div className="flex justify-between items-center text-sm py-2 border-b border-white/5">
              <span className="text-white/40">GPU Acceleration</span>
              <span className="text-primary font-mono text-xs">ENABLED</span>
            </div>
            <div className="flex justify-between items-center text-sm py-2">
              <span className="text-white/40">Uptime</span>
              <span className="font-mono text-xs">1,204:54:12</span>
            </div>
          </div>
        </div>

        <div className="glass-panel rounded-3xl p-6">
             <h4 className="text-xs font-black tracking-[0.2em] text-white/60 uppercase mb-6 flex items-center gap-2">
                <BarChart className="h-4 w-4 text-accent" />
                Detections Distribution
            </h4>
            <div className="space-y-4">
                <p className="text-[10px] text-white/30 leading-relaxed italic">
                    Historical data shows 84% of confirmed stego in this session used adaptive edge embedding.
                </p>
                <div className="aspect-square bg-white/5 rounded-2xl border border-white/10 flex items-center justify-center italic text-white/20 text-xs">
                    Graph Visualization Disabled in Demo
                </div>
            </div>
        </div>
      </div>
    </div>
  )
}
